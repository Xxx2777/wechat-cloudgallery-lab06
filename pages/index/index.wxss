.home-page {
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: 180rpx;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  height: 92rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  background: #ffffff;
  border-bottom: none;
}

.brand {
  display: flex;
  align-items: baseline;
}

.brand-text {
  font-size: 48rpx;
  font-weight: 900;
  color: #111111;
  letter-spacing: 0;
}

.brand-tag {
  margin-left: 14rpx;
  font-size: 17rpx;
  color: #b0b0b4;
  letter-spacing: 2rpx;
}

.publish-button {
  height: 66rpx;
  min-width: 150rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #111111;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 999rpx;
}

.top-actions {
  display: flex;
  align-items: center;
}

.mine-circle {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f0f0f0;
  flex: none;
}

.mine-circle-img {
  display: block;
  width: 100%;
  height: 100%;
}

.mine-circle-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6d6d72;
  font-size: 27rpx;
}

.mine-circle-tap {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  opacity: 0;
}

.publish-button-hover {
  opacity: 0.82;
}

.publish-plus {
  margin-right: 6rpx;
  font-size: 34rpx;
  line-height: 1;
}

.story-scroll {
  white-space: nowrap;
  padding: 22rpx 0 14rpx;
}

.story-row {
  display: inline-flex;
  padding: 0 18rpx;
}

.story-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 118rpx;
  margin-right: 10rpx;
}

.story-ring {
  width: 86rpx;
  height: 86rpx;
  padding: 5rpx;
  border: 4rpx solid #e3504a;
  border-radius: 50%;
  overflow: hidden;
}

.story-avatar {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #efefef;
}

.story-avatar-fallback {
  font-size: 26rpx;
}

.story-name {
  width: 118rpx;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #303034;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-card {
  border-bottom: 14rpx solid #f4f4f4;
  background: #ffffff;
}

.post-head {
  height: 104rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
}

.post-user {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.user-copy {
  min-width: 0;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1d1d1f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-loc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a9a9e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.more {
  font-size: 30rpx;
  letter-spacing: 3rpx;
  color: #4a4a4e;
}

.post-photo {
  display: block;
  width: 100%;
  background: #f3f3f3;
}

.post-body {
  padding: 22rpx 26rpx 26rpx;
}

.post-toolbar {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  min-width: 0;
}

.like-button {
  flex: none;
  height: 60rpx;
  min-width: 120rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  color: #444449;
  font-size: 26rpx;
}

.like-icon {
  margin-right: 10rpx;
  font-size: 40rpx;
  line-height: 1;
  color: #444449;
}

.like-button.liked .like-icon {
  color: #e3504a;
}

.like-button.liked .like-count {
  color: #e3504a;
  font-weight: 700;
}

.detail-button {
  flex: none;
  height: 60rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  color: #444449;
  font-size: 26rpx;
}

.post-date {
  margin-left: auto;
  flex: none;
  font-size: 22rpx;
  white-space: nowrap;
}

.post-caption {
  margin-top: 14rpx;
  display: flex;
  align-items: flex-start;
  color: #222225;
  font-size: 27rpx;
  line-height: 1.55;
}

.caption-user {
  font-weight: 700;
  margin-right: 14rpx;
  flex: none;
}

.caption-text {
  flex: 1;
}

.post-skeleton {
  padding: 22rpx 0 0;
}

.app-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 116rpx;
  padding: 0 46rpx env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 2rpx solid #ececec;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tab-btn {
  width: 200rpx;
  height: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8e8e93;
  font-size: 22rpx;
}

.tab-btn.active {
  color: #151517;
  font-weight: 700;
}

.tab-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: transparent;
  margin-bottom: 4rpx;
}

.tab-btn.active .tab-dot {
  background: #e3504a;
}

.tab-create {
  width: 200rpx;
  height: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #151517;
  font-size: 22rpx;
  font-weight: 700;
}

.tab-plus {
  width: 78rpx;
  height: 78rpx;
  margin-bottom: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #111113;
  color: #ffffff;
  border-radius: 26rpx;
  font-size: 52rpx;
  line-height: 1;
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.18);
}

.skeleton {
  background: #eeeeee;
  border-radius: 8rpx;
}

.skeleton-row {
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.skeleton-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
}

.skeleton-name {
  width: 240rpx;
  height: 28rpx;
  margin-left: 20rpx;
}

.skeleton-photo {
  width: 750rpx;
  height: 620rpx;
  border-radius: 0;
}

.skeleton-caption {
  width: 500rpx;
  height: 24rpx;
  margin: 24rpx 26rpx;
}
