.detail-page {
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: 300rpx;
}

.detail-photo {
  display: block;
  width: 750rpx;
  background: #f1f1f1;
}

.detail-meta {
  padding: 26rpx 30rpx 34rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.meta-head {
  display: flex;
  align-items: center;
}

.meta-user {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
}

.meta-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #1c1c1e;
}

.meta-loc {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.heart-btn {
  min-width: 130rpx;
  height: 70rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: #3d3d42;
  font-size: 27rpx;
}

.heart-icon {
  margin-right: 8rpx;
  font-size: 42rpx;
  line-height: 1;
}

.heart-btn.liked {
  color: #e3504a;
}

.heart-btn.liked .heart-icon {
  color: #e3504a;
}

.detail-caption {
  margin-top: 22rpx;
  display: flex;
  align-items: flex-start;
  color: #202023;
  font-size: 28rpx;
  line-height: 1.55;
}

.caption-user {
  font-weight: 800;
  margin-right: 12rpx;
  flex: none;
}

.caption-text {
  flex: 1;
}

.detail-date {
  display: block;
  margin-top: 18rpx;
  font-size: 23rpx;
}

.comments-block {
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 2rpx solid #f1f1f1;
}

.comments-head {
  display: flex;
  align-items: center;
}

.comments-title {
  font-size: 31rpx;
  font-weight: 800;
  color: #17171a;
}

.comments-count {
  margin-left: 10rpx;
  font-size: 23rpx;
}

.comment-list {
  margin-top: 18rpx;
}

.comment-item {
  padding: 18rpx 0;
  display: flex;
  align-items: flex-start;
  border-bottom: 2rpx solid #f6f6f6;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #ececec;
  flex: none;
}

.comment-avatar image {
  width: 100%;
  height: 100%;
}

.comment-avatar-text {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0c1b7;
  color: #ffffff;
  font-size: 20rpx;
  overflow: hidden;
}

.comment-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
}

.comment-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #55555a;
}

.comment-content {
  margin-top: 6rpx;
  font-size: 27rpx;
  color: #1d1d20;
  line-height: 1.5;
}

.no-comment {
  padding: 26rpx 0 8rpx;
  font-size: 24rpx;
}

.comment-editor {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.comment-placeholder {
  color: #b2b2b6;
}

.comment-send {
  width: 132rpx;
  height: 72rpx;
  margin-left: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #111113;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.action-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 118rpx;
  padding: 0 30rpx env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.96);
  border-top: 2rpx solid #ececec;
  display: flex;
  align-items: center;
}

.dock-item {
  flex: 1;
  height: 74rpx;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  color: #28282b;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.dock-item:last-child {
  margin-right: 0;
}

.dock-icon {
  margin-right: 8rpx;
  font-size: 30rpx;
  line-height: 1;
}

.detail-skeleton {
  padding-bottom: 40rpx;
}

.skeleton {
  background: #eeeeee;
}

.skeleton-photo {
  width: 750rpx;
  height: 800rpx;
}

.skeleton-text {
  height: 120rpx;
  margin: 28rpx 30rpx;
  border-radius: 20rpx;
}
