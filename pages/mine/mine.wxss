.mine-page {
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: 170rpx;
}

.mine-page .empty-card {
  margin: 80rpx 40rpx 0;
}

.profile-actions {
  margin: 8rpx 34rpx 0;
  display: flex;
  align-items: center;
}

.profile-action {
  height: 58rpx;
  padding: 0 26rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f2f2f2;
  color: #37373b;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.mine-hero {
  padding: 34rpx 34rpx 8rpx;
  display: flex;
  align-items: center;
}

.avatar-circle {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f2f2f2;
  position: relative;
  flex: none;
}

.avatar-circle-img {
  display: block;
  width: 100%;
  height: 100%;
}

.avatar-circle-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9a9a9e;
  font-size: 62rpx;
}

.avatar-picker {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  border-radius: 50%;
}

.hero-fields {
  flex: 1;
  margin-left: 34rpx;
  display: flex;
  flex-direction: column;
}

.nick-input {
  height: 76rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #161618;
}

.nick-placeholder {
  color: #b6b6ba;
  font-weight: 400;
}

.hero-tip {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #99999e;
}

.mine-stats {
  margin: 22rpx 34rpx 0;
  padding: 24rpx 0;
  border-top: 2rpx solid #f1f1f1;
  border-bottom: 2rpx solid #f1f1f1;
  display: flex;
  align-items: center;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 38rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8e8e93;
}

.profile-link {
  width: 180rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f3f3;
  color: #28282b;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.works-head {
  margin: 34rpx 30rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.works-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
}

.works-note {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
}

.manage-btn {
  height: 60rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  background: #f2f2f2;
  color: #37373b;
  font-size: 24rpx;
  border-radius: 999rpx;
}

.mine-grid {
  padding: 6rpx;
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 246rpx;
  height: 246rpx;
  position: relative;
  overflow: hidden;
  background: #f0f0f0;
}

.grid-image {
  display: block;
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  right: 0;
  top: 0;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.62);
  color: #ffffff;
  border-radius: 0;
  font-size: 40rpx;
  line-height: 1;
}

.app-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 116rpx;
  padding: 0 46rpx env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 2rpx solid #ececec;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tab-btn {
  width: 200rpx;
  height: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8e8e93;
  font-size: 22rpx;
}

.tab-btn.active {
  color: #151517;
  font-weight: 700;
}

.tab-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: transparent;
  margin-bottom: 4rpx;
}

.tab-btn.active .tab-dot {
  background: #e3504a;
}

.tab-create {
  width: 200rpx;
  height: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #111113;
  font-size: 22rpx;
  font-weight: 700;
}

.tab-plus {
  width: 78rpx;
  height: 78rpx;
  margin-bottom: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #111113;
  color: #ffffff;
  border-radius: 26rpx;
  font-size: 52rpx;
  line-height: 1;
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.18);
}
