page {
  background: #ffffff;
  color: #1c1c1e;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

view,
text,
image,
button,
navigator,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: 1.4;
  border-radius: 0;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: 160rpx;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #ececec;
  flex: none;
  overflow: hidden;
}

.avatar image {
  display: block;
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f2c6bd;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-card {
  margin: 180rpx 40rpx 0;
  padding: 90rpx 30rpx;
  background: #fafafa;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.empty-desc {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #9a9a9e;
}

.muted {
  color: #8e8e93;
}

.strong {
  font-weight: 700;
}

.divider {
  height: 2rpx;
  background: #f0f0f0;
  margin: 0 30rpx;
}
